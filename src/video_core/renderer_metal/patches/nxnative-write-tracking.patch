@@ -54,9 +54,18 @@ static pthread_mutex_t g_slot_mu = PTHREAD_MUTEX_INITIALIZER;   // Pool creation
 static _Atomic uint64_t g_range_epoch;
 static _Atomic uint64_t g_mp_calls, g_mp_pages, g_mp_ticks;   // This module's mprotect: call count, pages covered, time spent (mach timebase, safe in the page-fault path too)
 static _Atomic uint64_t g_mp_begun, g_mp_done;   // this module's protection changes begun and finished: on_fault tells from them whether its scan saw the protection as it is
+#ifdef LICHII_NVN_METAL_LIVE
+uint64_t nvn_direct_guest_of(uint64_t host);
+void nvn_direct_track_pages(uint64_t address, uint64_t size, int armed);
+#endif
 static void mp(uintptr_t a, size_t len, int prot) {
     atomic_fetch_add(&g_mp_begun, 1);
+#ifdef LICHII_NVN_METAL_LIVE
+    // Lichii owns the guest pages' protection: read-only pages are its write-tracked (rasterizer-cached) pages, whose writes reach nvn_dirty_cpu_written
+    uint64_t t = mach_absolute_time(); nvn_direct_track_pages(nvn_direct_guest_of(a), len, prot == PROT_READ); atomic_fetch_add(&g_mp_done, 1);
+#else
     uint64_t t = mach_absolute_time(); mprotect((void *)a, len, prot); atomic_fetch_add(&g_mp_done, 1);
+#endif
     atomic_fetch_add(&g_mp_ticks, mach_absolute_time() - t); atomic_fetch_add(&g_mp_calls, 1); atomic_fetch_add(&g_mp_pages, len >> g_shift);
 }
 
@@ -284,6 +293,21 @@ __attribute__((constructor)) static void dirty_init(void) {
     dm_fault_hook_register(on_fault); dm_guest_write_prep_register(prep_write);
 #endif
 }
+#ifdef LICHII_NVN_METAL_LIVE
+// A guest write to a tracked page, reported by Lichii's memory (counted as the fault it replaces), and the host's own writes into guest memory
+void nvn_dirty_cpu_written(void *addr, size_t len) {
+    uintptr_t a = (uintptr_t)addr, e = a + len; int n = atomic_load(&g_nr);
+    if (!len) return;
+    for (int i = 0; i < n; i++) {
+        range_t *r = rg(i);
+        if (!live_at(i) || e <= rb(r) || a >= re(r) || !pin(r)) continue;
+        uintptr_t base = rb(r), end = re(r);
+        if (e > base && a < end) { uintptr_t lo = a > base ? a : base, hi = e < end ? e : end; release_pages(r, (lo - base) >> g_shift, (hi - 1 - base) >> g_shift, &g_faults); }
+        unpin(r);
+    }
+}
+void dm_guest_write_prepare(void *addr, size_t len) { prep_write(addr, len); }
+#endif
 
